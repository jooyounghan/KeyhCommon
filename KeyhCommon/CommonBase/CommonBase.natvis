<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

	<Type Name="keyh::Vector&lt;*&gt;">
		<DisplayString>{{ size={_size} }}</DisplayString>
		<Expand>
			<Item Name="[size]">_size</Item>
			<Item Name="[capacity]">_capacity</Item>
			<IndexListItems>
				<Size>_size</Size>
				<ValueNode>*((($T1*)_data) + $i)</ValueNode>
			</IndexListItems>
		</Expand>
	</Type>

	<Type Name="keyh::Deque&lt;*&gt;">
		<DisplayString Condition="_isEmpty">{{ size=0 }}</DisplayString>
		<DisplayString Condition="!_isEmpty &amp;&amp; _top == _bottom">{{ size={_capacity} }}</DisplayString>
		<DisplayString Condition="!_isEmpty &amp;&amp; _top &gt; _bottom">{{ size={_bottom + _capacity - _top} }}</DisplayString>
		<DisplayString Condition="!_isEmpty &amp;&amp; _top &lt; _bottom">{{ size={_bottom - _top} }}</DisplayString>
		<Expand>
			<Item Name="[size]" Condition="_isEmpty">0</Item>
			<Item Name="[size]" Condition="!_isEmpty &amp;&amp; _top == _bottom">_capacity</Item>
			<Item Name="[size]" Condition="!_isEmpty &amp;&amp; _top &gt; _bottom">_bottom + _capacity - _top</Item>
			<Item Name="[size]" Condition="!_isEmpty &amp;&amp; _top &lt; _bottom">_bottom - _top</Item>
			<Item Name="[capacity]">_capacity</Item>
			<Item Name="[top]">_top</Item>
			<Item Name="[bottom]">_bottom</Item>
			<IndexListItems Condition="!_isEmpty">
				<Size>_top &gt;= _bottom ? (_top == _bottom ? _capacity : _bottom + _capacity - _top) : (_bottom - _top)</Size>
				<ValueNode>*((($T1*)_data) + ((_top + $i) &amp; (_capacity - 1)))</ValueNode>
			</IndexListItems>
		</Expand>
	</Type>

	<Type Name="keyh::Stack&lt;*&gt;">
		<DisplayString>{_deque}</DisplayString>
		<Expand>
			<ExpandedItem>_deque</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="keyh::StringView&lt;char&gt;">
		<DisplayString Condition="_data != nullptr">{_data,sb}</DisplayString>
		<DisplayString Condition="_data == nullptr">{}</DisplayString>
		<Expand>
			<Item Name="[length]">_length</Item>
			<Item Name="[text]">_data,sb,_length</Item>
		</Expand>
	</Type>
	<Type Name="keyh::StringView&lt;wchar_t&gt;">
		<DisplayString Condition="_data != nullptr">{_data,su}</DisplayString>
		<DisplayString Condition="_data == nullptr">{}</DisplayString>
		<Expand>
			<Item Name="[length]">_length</Item>
			<Item Name="[text]">_data,su,_length</Item>
		</Expand>
	</Type>

	<Type Name="keyh::Queue&lt;*&gt;">
		<DisplayString>{_deque}</DisplayString>
		<Expand>
			<ExpandedItem>_deque</ExpandedItem>
		</Expand>
	</Type>

	<Type Name="keyh::HashMap&lt;*&gt;">
		<DisplayString>{{ size={_size} }}</DisplayString>
		<Expand>
			<Item Name="[size]">_size</Item>
			<Item Name="[capacity]">_capacity</Item>
			<CustomListItems MaxItemsPerView="512">
				<Variable Name="i" InitialValue="0" />
				<Loop Condition="i &lt; _capacity">
					<If Condition="_buckets[i]._psl &gt;= 0">
						<Item Name="[{*($T1*)_buckets[i]._keyStorage}]">*($T2*)_buckets[i]._valueStorage</Item>
					</If>
					<Exec>i++</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>

	<Type Name="keyh::HashSet&lt;*&gt;">
		<DisplayString>{{ size={_size} }}</DisplayString>
		<Expand>
			<Item Name="[size]">_size</Item>
			<Item Name="[capacity]">_capacity</Item>
			<CustomListItems MaxItemsPerView="512">
				<Variable Name="i" InitialValue="0" />
				<Loop Condition="i &lt; _capacity">
					<If Condition="_buckets[i]._psl &gt;= 0">
						<Item Name="[{*($T1*)_buckets[i]._keyStorage}]">*($T1*)_buckets[i]._keyStorage</Item>
					</If>
					<Exec>i++</Exec>
				</Loop>
			</CustomListItems>
		</Expand>
	</Type>

	<Type Name="keyh::StaticString&lt;char&gt;">
		<DisplayString Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">{{ SSO, size={_size}, capacity=16, text={_ssoBuffer,s} }}</DisplayString>
		<DisplayString Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">{{ heap, size={_size}, capacity={_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64}, text={_heap,s} }}</DisplayString>
		<Expand>
			<Item Name="[mode]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">"SSO"</Item>
			<Item Name="[mode]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">"heap"</Item>
			<Item Name="[size]">_size</Item>
			<Item Name="[capacity]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">16</Item>
			<Item Name="[capacity]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64</Item>
			<Item Name="[capacityInfo: raw]">_capacityInfo</Item>
			<Item Name="[capacityInfo: heap flag]">(_capacityInfo &amp; 0x8000000000000000ui64) != 0</Item>
			<Item Name="[capacityInfo: capacity bits]">_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64</Item>
			<Item Name="[text]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">_ssoBuffer,s</Item>
			<Item Name="[text]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">_heap,s</Item>
		</Expand>
	</Type>
	<Type Name="keyh::StaticString&lt;wchar_t&gt;">
		<DisplayString Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">{{ SSO, size={_size}, capacity=16, text={_ssoBuffer,su} }}</DisplayString>
		<DisplayString Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">{{ heap, size={_size}, capacity={_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64}, text={_heap,su} }}</DisplayString>
		<Expand>
			<Item Name="[mode]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">"SSO"</Item>
			<Item Name="[mode]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">"heap"</Item>
			<Item Name="[size]">_size</Item>
			<Item Name="[capacity]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">16</Item>
			<Item Name="[capacity]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64</Item>
			<Item Name="[capacityInfo: raw]">_capacityInfo</Item>
			<Item Name="[capacityInfo: heap flag]">(_capacityInfo &amp; 0x8000000000000000ui64) != 0</Item>
			<Item Name="[capacityInfo: capacity bits]">_capacityInfo &amp; 0x7FFFFFFFFFFFFFFFui64</Item>
			<Item Name="[text]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) == 0">_ssoBuffer,su</Item>
			<Item Name="[text]" Condition="(_capacityInfo &amp; 0x8000000000000000ui64) != 0">_heap,su</Item>
		</Expand>
	</Type>

</AutoVisualizer>
