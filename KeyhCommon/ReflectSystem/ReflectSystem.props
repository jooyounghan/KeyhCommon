<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\CommonBase\CommonBase.props" Condition="'$(_CommonBasePropsImported)' != 'true'" />
  <PropertyGroup>
    <_ReflectSystemPropsImported>true</_ReflectSystemPropsImported>
    <KeyhCommonReflectCodegen Condition="'$(KeyhCommonReflectCodegen)' == '' and Exists('$(MSBuildThisFileDirectory)..\Tools\run_reflect_codegen.bat')">$(MSBuildThisFileDirectory)..\Tools\run_reflect_codegen.bat</KeyhCommonReflectCodegen>
    <KeyhCommonReflectCodegen Condition="'$(KeyhCommonReflectCodegen)' == ''">$(MSBuildThisFileDirectory)..\..\..\tools\keyhcommon\run_reflect_codegen.bat</KeyhCommonReflectCodegen>
    <PublicIncludeDirectories>$(MSBuildThisFileDirectory);$(PublicIncludeDirectories)</PublicIncludeDirectories>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(PublicPreprocessorDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ForcedIncludeFiles>%(ForcedIncludeFiles);ReflectSystemPch.h;ReflectionUtil.h;IReflectProperty.h;IReflectObject.h;ReflectMetaObject.h;ReflectObject.h;ReflectProperty.h;ReflectPropertyPolicy.h;ReflectSerializer.h;RuntimeBuilder.h;MacroCommon.h</ForcedIncludeFiles>
    </ClCompile>
    <PreBuildEvent Condition="'$(KeyhCommonSkipReflectCodegen)' != 'true'">
      <Command>call "$(KeyhCommonReflectCodegen)" "$(ProjectDir)."</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
</Project>
