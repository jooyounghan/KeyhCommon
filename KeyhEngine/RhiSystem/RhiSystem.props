<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\CommonBase\CommonBase.props" Condition="'$(_CommonBasePropsImported)' != 'true'" />
  <PropertyGroup>
    <_RhiSystemPropsImported>true</_RhiSystemPropsImported>
    <PublicIncludeDirectories>$(MSBuildThisFileDirectory);$(PublicIncludeDirectories)</PublicIncludeDirectories>
    <!-- Enable vcpkg manifest mode so that vcpkg.json in this directory is used -->
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(MSBuildThisFileDirectory)</VcpkgManifestRoot>
    <!-- Derive a default triplet when vcpkg integration has not set VcpkgTriplet -->
    <VcpkgTriplet Condition="'$(VcpkgTriplet)' == '' And '$(Platform)' == 'x64'">x64-windows</VcpkgTriplet>
    <VcpkgTriplet Condition="'$(VcpkgTriplet)' == '' And '$(Platform)' == 'Win32'">x86-windows</VcpkgTriplet>
    <!-- vcpkg installs packages under vcpkg_installed next to vcpkg.json -->
    <RhiSystemVcpkgInstalledDir>$(MSBuildThisFileDirectory)vcpkg_installed\$(VcpkgTriplet)\</RhiSystemVcpkgInstalledDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);$(RhiSystemVcpkgInstalledDir)include;%(AdditionalIncludeDirectories);</AdditionalIncludeDirectories>
      <ForcedIncludeFiles>%(ForcedIncludeFiles);RhiSystemPch.h;RhiEnum.h;RhiResourceBarrier.h;IRhiBuffer.h;IRhiCommandList.h;IRhiCommandPool.h;IRhiCommandQueue.h;IRhiComputePipeline.h;IRhiDevice.h;IRhiFence.h;IRhiGraphicsPipeline.h;IRhiInstance.h;IRhiMemoryHeap.h;IRhiPipelineLayout.h;IRhiSampler.h;IRhiSwapChain.h;IRhiTexture.h;</ForcedIncludeFiles>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(RhiSystemVcpkgInstalledDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'Win32' or '$(Platform)' == 'x64'">
    <ClCompile>
      <ForcedIncludeFiles>%(ForcedIncludeFiles);D3D12RhiEnum.h;D3D12RhiConvert.h;D3D12Buffer.h;D3D12CommandList.h;D3D12CommandPool.h;D3D12CommandQueue.h;D3D12ComputePipeline.h;D3D12Device.h;D3D12Fence.h;D3D12GlobalResourceHeap.h;D3D12GraphicsPipeline.h;D3D12Instance.h;D3D12MemoryHeap.h;D3D12PipelineLayout.h;D3D12Sampler.h;D3D12SwapChain.h;D3D12Texture.h;</ForcedIncludeFiles>
    </ClCompile>
    <Link>
      <!-- Windows SDK D3D12/DXGI libs are resolved via the platform SDK; dxcompiler comes from vcpkg directx-dxc -->
      <AdditionalDependencies>d3d12.lib;dxgi.lib;dxcompiler.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
